# VertexLearn AI — environment template (NAMES ONLY, no values)
# Copy to `.env` for local dev:  cp .env.example .env
# NEVER commit `.env`. Only this file (names, no values) is tracked.

# --- Runtime ---
NODE_ENV=
LOG_LEVEL=
API_PORT=
PORT=
FRONTEND_URL=

# --- Auth (Phase 1: REQUIRED BY PRD) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=
BCRYPT_ROUNDS=
COOKIE_SECURE=

# --- PostgreSQL (Phase 1: REQUIRED BY PRD) ---
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Redis (Phase 1: REQUIRED BY PRD) ---
REDIS_URL=
REDIS_PASSWORD=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
RATE_LIMIT_ENFORCE=
DISABLE_RATE_LIMITS=

# --- AI service (Phase 3: REQUIRED BY PRD; Phase 7: real providers via env) ---
# AI-service Postgres hop (chunk retrieval). Bounded so an unreachable or
# wedged database can never hang a request; AI_DB_SSL_MODE overrides the TLS
# policy (defaults: plain TCP on localhost/in-stack, require elsewhere).
AI_DB_CONNECT_TIMEOUT_S=
AI_DB_STATEMENT_TIMEOUT_MS=
AI_DB_SSL_MODE=
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
AI_SERVICE_PORT=
AI_SERVICE_TIMEOUT_MS=
# One backend->AI-service chat request. Keep small (12s): a warm hop answers in
# ~1-3s, and a slow/unreachable hop must NOT hang the user's message.
AI_SERVICE_CHAT_TIMEOUT_MS=
# Same cap for the generation routes (summarize, quiz drafts, flashcards,
# study plan); they fall back to their local implementations.
AI_SERVICE_GENERATE_TIMEOUT_MS=
# After a failed hop, skip it for this long and answer from the local RAG path.
AI_SERVICE_BREAKER_MS=
# AI Tutor chat route. Pollinations is the primary chat provider
# (live-verified working); Groq/OpenRouter/Mistral/Gemini/Anthropic compat
# paths are kept as fallbacks. Embeddings never use chat providers — they
# stay Gemini (or deterministic w/o key).
AI_TUTOR_PROVIDER=
POLLINATIONS_API_KEY=
POLLINATIONS_CHAT_MODEL=
POLLINATIONS_BASE_URL=
POLLINATIONS_TIMEOUT_S=
POLLINATIONS_TIMEOUT_MS=
GROQ_API_KEY=
GROQ_CHAT_MODEL=
GROQ_BASE_URL=
LLM_PROVIDER=
LLM_API_KEY=
GEMINI_API_KEY=
LLM_BASE_URL=
LLM_CHAT_MODEL=
LLM_TIMEOUT_MS=
LLM_MAX_RETRIES=
# AI Tutor answer budget: per-provider attempt cap and total cap for the
# provider fallback chain (primary, then any other provider with a key).
LLM_ATTEMPT_TIMEOUT_MS=
AI_ANSWER_BUDGET_MS=
LLM_TIMEOUT_S=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_MS=
EMBEDDING_DIM=
RAG_TOP_K=
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=

# --- AI Tutor chat generation provider (server-side only; never the frontend) ---
# AI_TUTOR_PROVIDER selects the chat provider: openrouter | mistral | gemini | anthropic | mock
# Embeddings are always Gemini (gemini-embedding-001, 1536 dims) regardless of this.
AI_TUTOR_PROVIDER=
AI_TUTOR_API_KEY=
AI_TUTOR_BASE_URL=
AI_TUTOR_MODEL=
AI_TUTOR_CHAT_MODEL=

# --- Object storage (Phase 6: MinIO/S3-compatible, private buckets) ---
STORAGE_ENDPOINT=
STORAGE_PUBLIC_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=
UPLOAD_MAX_MB=
STORAGE_BUCKET_VIDEOS=
STORAGE_BUCKET_MATERIALS=
STORAGE_BUCKET_SUBMISSIONS=
STORAGE_BUCKET_CERTIFICATES=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
CERT_STORAGE_DIR=

# --- Frontend (later phase) ---
VITE_API_URL=
VITE_APP_NAME=
VITE_DEFAULT_LOCALE=

# --- Email notifications (Phase 5: abstraction, mocked in tests) ---
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=

# --- Demo seed (local dev only, never real secrets) ---
SEED_DEMO=
DEMO_ADMIN_EMAIL=
DEMO_INSTRUCTOR_EMAIL=
DEMO_STUDENT_EMAIL=
DEMO_PASSWORD=
