# VertexLearn backend — environment template (NAMES ONLY, no values).
# Copy to `.env` for local dev; production values live in the Render dashboard.
# NEVER commit real secrets. See root .env.example for the full inventory.
NODE_ENV=
LOG_LEVEL=
API_PORT=
# Render injects PORT automatically; API_PORT stays canonical locally.
PORT=
FRONTEND_URL=
JWT_ACCESS_SECRET=
